# Export only these least-privilege values for normal ASP.NET runtime.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=accesslearn;Username=accesslearn_app;Password=replace-with-a-local-app-password
ObjectStorage__ServiceUrl=http://localhost:9000
ObjectStorage__PublicServiceUrl=http://localhost:9000
ObjectStorage__AccessKey=accesslearn_app
ObjectStorage__SecretKey=replace-with-a-local-app-secret-at-least-8-characters
ObjectStorage__BucketName=accesslearn
ApiKeyAuthentication__Pepper=replace-with-at-least-32-random-characters
MediaProbe__ExecutablePath=.tools/ffmpeg/bin/ffprobe.exe
PlayerDelivery__PublicApiBaseUrl=https://localhost:7121
