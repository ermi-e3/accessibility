@accessibility.Api_HostAddress = https://localhost:7121
@accessibility.Api_ApiKey = replace-with-server-held-integration-key
@accessibility.Api_LessonId = replace-with-lesson-id
@accessibility.Api_TranscriptId = replace-with-transcript-id
@accessibility.Api_TranscriptVersion = 1
@accessibility.Api_LessonVersion = 1
@accessibility.Api_SourceAssetId = replace-with-primary-media-asset-id
@accessibility.Api_ProcessingJobId = replace-with-processing-job-id
@accessibility.Api_DocumentId = replace-with-document-id
@accessibility.Api_DocumentImageId = replace-with-document-image-id
@accessibility.Api_DocumentOutputId = replace-with-document-output-id
@accessibility.Api_DocumentVersion = 1

GET {{accessibility.Api_HostAddress}}/health/live
Accept: application/json

###

POST {{accessibility.Api_HostAddress}}/api/v1/lessons/{{accessibility.Api_LessonId}}/transcripts
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

{
  "language": "en",
  "segments": [
    {
      "sequence": 0,
      "startMilliseconds": 0,
      "endMilliseconds": 2500,
      "text": "Welcome to the accessible lesson.",
      "speakerLabel": "Educator"
    }
  ]
}

###

POST {{accessibility.Api_HostAddress}}/api/v1/transcripts/{{accessibility.Api_TranscriptId}}/approve
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}
If-Match: "{{accessibility.Api_TranscriptVersion}}"

###

POST {{accessibility.Api_HostAddress}}/api/v1/lessons/{{accessibility.Api_LessonId}}/publish
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}
If-Match: "{{accessibility.Api_LessonVersion}}"

###

GET {{accessibility.Api_HostAddress}}/api/v1/public/lessons/{{accessibility.Api_LessonId}}/manifest
Accept: application/json

###

POST {{accessibility.Api_HostAddress}}/api/v1/lessons/{{accessibility.Api_LessonId}}/processing-jobs
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}
Idempotency-Key: demo-processing-request

{
  "sourceAssetId": "{{accessibility.Api_SourceAssetId}}",
  "targetLanguages": ["en", "am"]
}

###

GET {{accessibility.Api_HostAddress}}/api/v1/processing-jobs/{{accessibility.Api_ProcessingJobId}}
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

GET {{accessibility.Api_HostAddress}}/health/ready
Accept: application/json

###

GET {{accessibility.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{accessibility.Api_HostAddress}}/api/v1/auth/antiforgery
Accept: application/json

###

GET {{accessibility.Api_HostAddress}}/api/v1/lessons?limit=20
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

POST {{accessibility.Api_HostAddress}}/api/v1/lessons
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

{
  "title": "Accessible lesson",
  "description": "Lesson created through the scoped integration API.",
  "sourceLanguage": "en"
}

###

POST {{accessibility.Api_HostAddress}}/api/v1/lessons/{{accessibility.Api_LessonId}}/documents
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}
Content-Type: multipart/form-data; boundary=accesslearn-document-boundary

--accesslearn-document-boundary
Content-Disposition: form-data; name="title"

Inclusive communication study guide
--accesslearn-document-boundary
Content-Disposition: form-data; name="language"

en
--accesslearn-document-boundary
Content-Disposition: form-data; name="file"; filename="structured-en-am.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ../../sample-content/documents/structured-en-am.docx
--accesslearn-document-boundary--

###

GET {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

GET {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}/normalized-model
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

GET {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}/preview
Accept: text/html
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

PATCH {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}/images/{{accessibility.Api_DocumentImageId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}
If-Match: "{{accessibility.Api_DocumentVersion}}"

{
  "altText": "Reviewed description of the meaningful image.",
  "isDecorative": false
}

###

POST {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}/outputs
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}
If-Match: "{{accessibility.Api_DocumentVersion}}"
Idempotency-Key: demo-document-output-request

{
  "formats": ["html", "pdf"]
}

###

GET {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}/outputs
Accept: application/json
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

GET {{accessibility.Api_HostAddress}}/api/v1/documents/{{accessibility.Api_DocumentId}}/outputs/{{accessibility.Api_DocumentOutputId}}/download
Authorization: Bearer {{accessibility.Api_ApiKey}}

###

GET {{accessibility.Api_HostAddress}}/api/v1/public/documents/{{accessibility.Api_DocumentOutputId}}

###
