# Export this file only for the one-time `--initialize` process, then remove it
# from the runtime environment. It includes both runtime and provisioning access.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=accesslearn;Username=accesslearn_app;Password=replace-with-a-local-app-password
ConnectionStrings__MigrationDatabase=Host=localhost;Port=5432;Database=accesslearn;Username=accesslearn_migrator;Password=replace-with-a-local-migration-password
ObjectStorage__ServiceUrl=http://localhost:9000
ObjectStorage__AccessKey=accesslearn_app
ObjectStorage__SecretKey=replace-with-a-local-app-secret-at-least-8-characters
ObjectStorage__BucketName=accesslearn
ApiKeyAuthentication__Pepper=replace-with-at-least-32-random-characters
MediaProbe__ExecutablePath=.tools/ffmpeg/bin/ffprobe.exe
ObjectStorageProvisioning__AccessKey=accesslearn_admin
ObjectStorageProvisioning__SecretKey=replace-with-a-local-admin-secret-at-least-8-characters
BootstrapAdmin__Email=admin@example.test
BootstrapAdmin__DisplayName=AccessLearn Administrator
BootstrapAdmin__Password=replace-with-a-strong-development-password
