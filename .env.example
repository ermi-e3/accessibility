# Copy to .env for local Docker services. Do not commit real credentials.
POSTGRES_DB=accesslearn
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-local-admin-password
ACCESSLEARN_MIGRATION_USER=accesslearn_migrator
ACCESSLEARN_MIGRATION_PASSWORD=replace-with-a-local-migration-password
ACCESSLEARN_DB_USER=accesslearn_app
ACCESSLEARN_DB_PASSWORD=replace-with-a-local-app-password
MINIO_ROOT_USER=accesslearn_admin
MINIO_ROOT_PASSWORD=replace-with-a-local-admin-secret-at-least-8-characters
MINIO_APP_USER=accesslearn_app
MINIO_APP_PASSWORD=replace-with-a-local-app-secret-at-least-8-characters
MINIO_BUCKET=accesslearn
